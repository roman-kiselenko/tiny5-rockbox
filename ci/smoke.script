# CI smoke test for the simulator (see uisimulator/common/sim_script.c).
# Boots, walks Home, opens Settings, comes back, and writes a PNG per step.
# Commands: wait <ms> | press <button> [ms] | hold <button> <ms> |
#           wheel fwd|back <ticks> | shot <name> | quit
# Buttons: power menu back play prev next volup voldown

wait 6000          # boot: the logo holds 3 s, then the 1 s zoom animation
shot home

wheel fwd 5        # Music, Cover Flow, Files, Playlists, Bluetooth -> Settings
wait 500
shot home-settings-selected

press play
wait 1500
shot settings

wheel fwd 3
wait 500
shot settings-scrolled

press back
wait 1500
shot home-again

press power        # lock screen
wait 1000
shot lock

press power        # unlock
wait 1000
shot home-unlocked

quit
